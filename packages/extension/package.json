{
  "name": "data-pilot-vscode",
  "displayName": "Data Pilot",
  "description": "Find, understand, and prepare test datasets without loading everything into memory.",
  "version": "0.0.1",
  "private": true,
  "publisher": "data-pilot",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "activationEvents": [
    "onCommand:dataPilot.openDataset",
    "onCommand:dataPilot.openDatasetResource",
    "onCommand:dataPilot.openDatasetCustomEditor",
    "onView:dataPilot.datasets",
    "onView:dataPilot.savedQueries",
    "onCommand:dataPilot.openSavedQuery",
    "onLanguage:data-pilot-dql",
    "onCommand:dataPilot.openQueryInEditor",
    "onCommand:dataPilot.runDql",
    "onCommand:dataPilot.runDqlOn",
    "onCustomEditor:dataPilot.dataset"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Data Pilot allows explicit open, metadata, preview, and value inspection only. Edit, export, global scans, and agent operations are blocked.",
      "restrictedConfigurations": [
        "dataPilot.allowExport",
        "dataPilot.allowEdit"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dataPilot.openDataset",
        "title": "Data Pilot: Open Dataset",
        "icon": "$(table)"
      },
      {
        "command": "dataPilot.openDatasetResource",
        "title": "Open with Data Pilot",
        "icon": "$(table)"
      },
      {
        "command": "dataPilot.showLog",
        "title": "Data Pilot: Show Log"
      },
      {
        "command": "dataPilot.openDatasetCustomEditor",
        "title": "Data Pilot: Open as Custom Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "dataPilot.openQueryInEditor",
        "title": "Data Pilot: Open Query in Editor"
      },
      {
        "command": "dataPilot.runDql",
        "title": "Data Pilot: Run Query",
        "icon": "$(play)"
      },
      {
        "command": "dataPilot.runDqlOn",
        "title": "Data Pilot: Run on Dataset…"
      },
      {
        "command": "dataPilot.showDqlTarget",
        "title": "Data Pilot: Show Query Dataset"
      },
      {
        "command": "dataPilot.openSavedQuery",
        "title": "Data Pilot: Open Saved Query"
      }
    ],
    "languages": [
      {
        "id": "data-pilot-dql",
        "aliases": ["Data Pilot DQL", "DQL"],
        "extensions": [".dql"]
      }
    ],
    "grammars": [
      {
        "language": "data-pilot-dql",
        "scopeName": "source.data-pilot-dql",
        "path": "./syntaxes/dql.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataPilot",
          "title": "Data Pilot",
          "icon": "media/data-pilot.svg"
        }
      ]
    },
    "views": {
      "dataPilot": [
        {
          "id": "dataPilot.datasets",
          "name": "Datasets"
        },
        {
          "id": "dataPilot.savedQueries",
          "name": "Saved Queries"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataPilot.datasets",
        "contents": "No open datasets.\n[Open Dataset](command:dataPilot.openDataset)"
      },
      {
        "view": "dataPilot.savedQueries",
        "contents": "No saved queries."
      }
    ],
    "customEditors": [
      {
        "viewType": "dataPilot.dataset",
        "displayName": "Data Pilot",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.jsonl" },
          { "filenamePattern": "*.ndjson" }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dataPilot.openDatasetResource",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(csv|jsonl|ndjson)$/i",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "dataPilot.openDatasetResource",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(csv|jsonl|ndjson)$/i",
          "group": "navigation@1"
        },
        {
          "command": "dataPilot.openDatasetCustomEditor",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(csv|jsonl|ndjson)$/i",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "dataPilot.openQueryInEditor",
          "when": "activeCustomEditorId == dataPilot.dataset",
          "group": "navigation@3"
        },
        {
          "command": "dataPilot.runDql",
          "when": "editorLangId == data-pilot-dql",
          "group": "navigation@0"
        },
        {
          "command": "dataPilot.runDqlOn",
          "when": "editorLangId == data-pilot-dql",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Data Pilot",
      "properties": {
        "dataPilot.allowExport": {
          "type": "boolean",
          "default": true,
          "description": "Allow exporting query results (trusted workspaces only)."
        },
        "dataPilot.allowEdit": {
          "type": "boolean",
          "default": true,
          "description": "Allow editing small fixtures (trusted workspaces only)."
        },
        "dataPilot.rssLimitMb": {
          "type": "number",
          "default": 256,
          "description": "Soft RSS limit (MiB) for the engine child process before terminate/recover."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run compile && mkdir -p ../../tmp && npx @vscode/vsce package --no-dependencies --allow-missing-repository -o ../../tmp/data-pilot.vsix",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@data-pilot/contracts": "0.0.0",
    "@data-pilot/core": "0.0.0",
    "@data-pilot/dql": "0.0.0",
    "@data-pilot/runtime-node": "0.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.1"
  }
}
